{
  "name": "vpnmanager",
  "version": "0.1.4",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build:compile": "next build --webpack --experimental-build-mode compile",
    "build:next": "next build --webpack",
    "build": "pnpm run build:next",
    "start": "node --env-file=.env --env-file=.env.local .next/standalone/apps/vpnmanager/server.js",
    "lint:check": "eslint .",
    "lint": "eslint --fix .",
    "clean": "rm -rf .next .turbo node_modules",
    "playwright": "npx playwright test --pass-with-no-tests"
  },
  "dependencies": {
    "@commons-ui/core": "workspace:*",
    "@commons-ui/next": "workspace:*",
    "@emotion/cache": "catalog:",
    "@emotion/react": "catalog:",
    "@emotion/server": "catalog:",
    "@emotion/styled": "catalog:",
    "@mui/material": "catalog:",
    "@mui/utils": "catalog:",
    "@next/env": "catalog:next-16",
    "@next/third-parties": "catalog:next-16",
    "@sendgrid/mail": "catalog:",
    "@sentry/nextjs": "catalog:next-16",
    "@svgr/webpack": "catalog:",
    "better-sqlite3": "catalog:",
    "date-fns": "catalog:",
    "googleapis": "catalog:",
    "next": "catalog:next-16",
    "next-auth": "catalog:",
    "react": "catalog:react-19",
    "react-dom": "catalog:react-19",
    "tsc-alias": "catalog:"
  },
  "devDependencies": {
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:react-19",
    "@types/react-dom": "catalog:react-19",
    "eslint": "catalog:",
    "eslint-config-commons-ui": "workspace:*",
    "eslint-config-next": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
