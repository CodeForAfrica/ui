{
  "name": "techlabblog",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build:compile": "next build --webpack --experimental-build-mode compile",
    "build:next": "next build --webpack",
    "copy:assets": "cp -r public .next/standalone/apps/techlabblog/public && cp -r .next/static .next/standalone/apps/techlabblog/.next/static",
    "build": "pnpm run build:next && pnpm run copy:assets",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local .next/standalone/apps/techlabblog/server.js",
    "lint:check": "eslint .",
    "lint": "eslint --fix .",
    "clean": "rm -rf .next .turbo node_modules"
  },
  "dependencies": {
    "@commons-ui/core": "workspace:*",
    "@commons-ui/next": "workspace:*",
    "@emotion/cache": "catalog:",
    "@emotion/react": "catalog:",
    "@emotion/styled": "catalog:",
    "@mdx-js/loader": "catalog:",
    "@mdx-js/mdx": "catalog:",
    "@mui/material": "catalog:",
    "@mui/material-nextjs": "catalog:next-16",
    "@mui/utils": "catalog:",
    "@next/third-parties": "catalog:next-16",
    "@next/mdx": "catalog:next-16",
    "date-fns": "catalog:",
    "next": "catalog:next-16",
    "parse-numeric-range": "catalog:",
    "react": "catalog:react-19",
    "react-dom": "catalog:react-19",
    "rehype-autolink-headings": "catalog:",
    "rehype-pretty-code": "catalog:",
    "rehype-slug": "catalog:",
    "remark-frontmatter": "catalog:",
    "remark-mdx-frontmatter": "catalog:",
    "shiki": "catalog:"
  },
  "devDependencies": {
    "@svgr/webpack": "catalog:",
    "@types/mdx": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:react-19",
    "@types/react-dom": "catalog:react-19",
    "eslint": "catalog:",
    "eslint-config-commons-ui": "workspace:*",
    "eslint-config-next": "catalog:",
    "eslint-import-resolver-webpack": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-mdx": "catalog:",
    "typescript": "catalog:"
  }
}
