{
  "name": "roboshield",
  "version": "0.1.17",
  "private": true,
  "type": "module",
  "scripts": {
    "build:compile": "next build --webpack --experimental-build-mode compile",
    "build:next": "next build --webpack",
    "build": "pnpm run build:next",
    "payload-migrate:create": "payload migrate:create",
    "payload-migrate:status": "payload migrate:status",
    "payload-migrate:up": "payload migrate",
    "payload-migrate:down": "payload migrate:down",
    "start": "node --env-file=.env --env-file=.env.local .next/standalone/apps/roboshield/server.js",
    "dev": "NODE_OPTIONS='--inspect' next dev --webpack",
    "clean": "rm -rf .next .turbo build dist node_modules",
    "lint:check": "eslint .",
    "lint": "eslint --fix .",
    "generate:types": "payload generate:types"
  },
